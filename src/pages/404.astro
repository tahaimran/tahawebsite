---
import Base from '../layouts/Base.astro';
import HomeScreen from '../components/HomeScreen.astro';
---

<Base title="Page not found | Taha Imran" noindex>
  <div class="wrap page">
    <h1>This page doesn’t exist.</h1>
    <p class="lede">The link may be old or mistyped. Pick an app below, or go to the <a href="/">home page</a>.</p>
    <div class="screen"><HomeScreen /></div>
  </div>
</Base>

<style>
  .page {
    padding-top: clamp(40px, 7vw, 80px);
  }
  h1 {
    font-size: var(--step-4);
    font-weight: 750;
    max-width: 14ch;
  }
  .lede {
    margin-top: 18px;
  }
  .screen {
    margin-top: 40px;
    max-width: 560px;
  }
</style>
