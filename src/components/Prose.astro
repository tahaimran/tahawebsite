---
// Long-form text (privacy policies). Styles reach into rendered Markdown with :global.
---

<div class="prose"><slot /></div>

<style>
  .prose {
    max-width: 68ch;
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  .prose :global(h2) {
    font-size: var(--step-2);
    margin: 2.2em 0 0.6em;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(p),
  .prose :global(ul) {
    margin: 0 0 1em;
  }
  .prose :global(ul) {
    padding-left: 1.2em;
  }
  .prose :global(li + li) {
    margin-top: 0.35em;
  }
  .prose :global(a) {
    overflow-wrap: anywhere;
  }
</style>
