---
import { apps } from '../data/apps';
import { site } from '../data/site';
---

<footer class="site-footer">
  <div class="wrap grid">
    <div class="about">
      <p class="mark">Taha Imran</p>
      <p>Small Android apps that work offline and keep your data on your phone.</p>
    </div>
    <nav aria-label="Apps">
      <h2>Apps</h2>
      <ul>{apps.map((app) => <li><a href={`/apps/${app.slug}/`}>{app.name}</a></li>)}</ul>
    </nav>
    <nav aria-label="Privacy policies">
      <h2>Privacy policies</h2>
      <ul>{apps.map((app) => <li><a href={`/apps/${app.slug}/privacy/`}>{app.name}</a></li>)}</ul>
    </nav>
    <div>
      <h2>Help</h2>
      <ul>
        <li><a href="/support/">Support</a></li>
        <li><a href="/testing/">Test the apps early</a></li>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href="/privacy/">This website’s privacy</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap legal">
    <p>© {new Date().getFullYear()} Taha Imran. Android and Google Play are trademarks of Google LLC.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(64px, 10vw, 120px);
    border-top: 1px solid var(--line);
    background: var(--surface);
    padding-block: 48px 32px;
  }
  .grid {
    display: grid;
    grid-template-columns: 1.4fr repeat(3, 1fr);
    gap: 32px;
  }
  .mark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    margin-bottom: 8px;
  }
  .about p:last-child {
    color: var(--muted);
    max-width: 30ch;
  }
  h2 {
    font-size: var(--step-0);
    letter-spacing: 0;
    margin-bottom: 10px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  li a {
    display: inline-block;
    padding-block: 5px;
    color: var(--muted);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  li a:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .legal {
    margin-top: 40px;
    color: var(--muted);
    font-size: var(--step--1);
  }
  @media (max-width: 760px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .about {
      grid-column: 1 / -1;
    }
  }
</style>
